{
  "name": "@ayui124/dsh-web-search-tools",
  "version": "1.0.7",
  "description": "Tavily and Brave Search tools for DeepSeek Harness agents",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "cordis",
    "agent-tools",
    "web-search",
    "tavily",
    "brave-search"
  ],
  "homepage": "https://github.com/AYui124/dsh-web-search-tools#readme",
  "bugs": {
    "url": "https://github.com/AYui124/dsh-web-search-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AYui124/dsh-web-search-tools.git"
  },
  "author": "AYui124",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "api.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check api.js && node --check client.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
